# Git ignore file - prevents committing sensitive information

# Environment variables
.env
.env.local
.env.*.local

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE settings
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS specific
Thumbs.db
.DS_Store

# Logs
logs/
*.log

# Optional npm cache
.npm

# Production build
dist/
build/

# Temporary files
tmp/
temp/
*.tmp
