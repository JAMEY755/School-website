# Email Configuration
# Using Gmail, Outlook, or other SMTP providers

# Gmail Setup:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the app password below WITHOUT spaces (not your regular Gmail password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=yourappasswordwithoutspaces
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Yope International High School

# Email Recipients (comma-separated for multiple recipients)
ADMISSIONS_EMAIL=admissions@yope-school.com
ADMIN_EMAIL=admin@yope-school.com

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: For HTTPS/Production
# HTTPS_ENABLED=false
